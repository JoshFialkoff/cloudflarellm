# Server-side streaming for /bots/* flows that read typebots/*.dsl (OpenAI)
OPENAI_API_KEY=

# Server-only: Discord incoming webhook URL for homepage email sign-ups
# Create in Discord: Channel settings → Integrations → Webhooks
DISCORD_SIGNUP_WEBHOOK_URL=

# PostHog product analytics + LLM observability (client + server read the public key).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server / CI only: PostHog Query API for scheduled digests (daily analytics, error triage).
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.posthog.com

# Incoming webhook for the daily analytics Discord report (GitHub secret: DISCORD_DAILY_ANALYTICS_WEBHOOK_URL).
# DISCORD_DAILY_ANALYTICS_WEBHOOK_URL=

# Optional GA4 (G-XXXXXXXXXX). When set, conversion dataLayer pushes also call gtag().
# Skip if GA4 is already sending the same events from GTM to avoid double counting.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Homepage Typebot embed (public bot id). Required for `lib/homeTypebotBootstrap.js` / hero embed.
# Copy your Typebot “public” / publish id into .env.local on your Mac — do not commit real ids here.
NEXT_PUBLIC_TYPEBOT_ID=

# Optional: override Typebot viewer API host (default: see `lib/typebotEnv.js`).
# NEXT_PUBLIC_TYPEBOT_API_HOST=

# Server-only: OpenAI for streamed `/api/bots/llm-stream` and native `/api/chat` (Fast Top-3).
OPENAI_API_KEY=

# When unset (default): instant local top-3 list streams immediately — no OpenAI wait.
# Set to 1 to append an LLM refinement after the instant list (slower).
# NATIVE_CHAT_USE_LLM=1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (OrcaRouter, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Homepage wizard chat engine: `dify` (Dify Fast Top-3 + knowledge base) or `native` (in-repo demo catalog).
# When unset: native if OPENAI_API_KEY is set and DIFY_API_KEY is empty.
# Cloudflare tunnel preview (agent1.assistedly.ai) reads .env.local on your Mac — restart npm run dev after changes.
CHAT_ENGINE=dify

# Fast Top-3 advanced-chat app — Studio: https://dify.forwardjump.com/app/b0399663-f1c1-49a7-949e-ee04effb71a3/workflow
# Uses /v1/chat-messages (leave DIFY_APP_KIND unset; not workflow).
DIFY_API_KEY=app-G69M5J3yWa6i1ogESyddy2vb

# With CHAT_ENGINE=dify, instant native prefix is off by default (Dify KB only).
# Set DIFY_INSTANT_PREFIX=1 to prepend local demo facilities before Dify responds.
# DIFY_INSTANT_PREFIX=0

# Optional override for workflow apps. Leave empty for Fast Top-3 advanced-chat (homepage wizard).
DIFY_WORKFLOW_API_KEY=

# Dify API base URL (defaults to https://dify.forwardjump.com/v1 when unset).
# Override if your Dify instance is hosted elsewhere.
#
# ⚠️ ⚠️ ⚠️  CRITICAL — READ THIS  ⚠️ ⚠️ ⚠️
#   CORRECT:   https://dify.forwardjump.com/v1           ✓ Works
#   WRONG:     https://dify.forwardjump.com/api/v1        ✗ 404 (Console API route — no chat-messages)
#
# The Dify nginx proxy routes:
#   /api → Console API (login, apps CRUD). Does NOT serve chat-messages.
#   /v1  → Public API  (chat-messages, workflows/run, parameters).
#
# Including /api/ in the path causes ALL Dify chat requests to 404 → 502 → "AI has gone AWOL".
# If you see that error, check this variable FIRST.
DIFY_API_BASE_URL=https://dify.forwardjump.com/v1

# Dify app type: set only for workflow apps (`/v1/workflows/run`). Must be unset for Fast Top-3
# advanced-chat (`/v1/chat-messages`). If set to workflow with CHAT_ENGINE=dify, chat is forced to
# chat-messages — remove DIFY_APP_KIND=workflow from .env.local to avoid confusion.
# DIFY_APP_KIND=workflow

# Studio console token for `npm run dify:import` (not the app API key).
# DIFY_CONSOLE_TOKEN=
# DIFY_CONSOLE_BASE_URL=https://dify.forwardjump.com

# Server-only: Dify API key for per-facility AI deep-dive reports (`POST /api/facility-deep-dive`).
# Uses a separate Dify chat app at dify.forwardjump.com/v1.
FACILITY_DEEP_DIVE_DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the facility deep-dive Dify app (defaults to https://dify.forwardjump.com/v1 when unset).
FACILITY_DEEP_DIVE_DIFY_BASE_URL=https://dify.forwardjump.com/v1

# Server-only: Dify API key for wizard KB insight bullets (`POST /api/facility-kb-insight`).
# Import `dify/facility-kb-insight-ma.dsl.yml` to Dify Studio, publish, then paste the app API key.
# Knowledge base dataset: dcbc8963-82b5-488c-93b6-22e7fe62fcf1
FACILITY_KB_INSIGHT_DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the facility KB insight Dify app (defaults to https://dify.forwardjump.com/v1 when unset).
FACILITY_KB_INSIGHT_DIFY_BASE_URL=https://dify.forwardjump.com/v1

# Public Stripe payment link shown as an upgrade CTA on facility AI reports.
NEXT_PUBLIC_STRIPE_UPGRADE_URL=https://buy.stripe.com/fZubJ02Gd3eKeyV5lm6Ri00

# Optional explicit override for the testing-site URL printed after `npm run build`.
# If unset, the script will try common host URL env vars such as URL, SITE_URL,
# NEXT_PUBLIC_SITE_URL, DEPLOY_PRIME_URL, CF_PAGES_URL, and VERCEL_URL.
# Example: https://staging.assistedly.ai
# TEST_SITE_URL=

# Homepage #assistant (see `lib/homepageAssistantKind.js` + `HomeAssistantShell.js`):
# - unset / wizard = AssistedlyWizard + Dify `/api/chat` (default)
# - player = in-house TypebotPlayer + `homepage-ai-assistant.player.json` + `/api/bots/llm-stream`
# - typebot = legacy @typebot.io/react embed (needs NEXT_PUBLIC_TYPEBOT_ID)
# NEXT_PUBLIC_HOMEPAGE_ASSISTANT=

# Public origin for magic-link emails when the API sees localhost (tunnel bridge / local dev).
# Defaults to DEV_PUBLIC_URL, then NEXT_PUBLIC_SITE_URL, then https://assistedly.ai.
# AUTH_PUBLIC_URL=https://agent1.assistedly.ai

# Server-only: Resend delivery for auth magic links (`/api/auth/request-magic-link`).
# Required for email delivery in local dev and production. Copy from production `.env.production`
# or Resend dashboard. Restart `npm run dev` after adding to `.env.local`.
# Use an active Resend API key exactly as issued, e.g. re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=<REPLACE_WITH_RESEND_API_KEY>

# Optional email sender override for magic links (defaults to Assistedly <hello@assistedly.ai>).
# The sender/domain must be verified in Resend.
AUTH_EMAIL_FROM="Assistedly <hello@assistedly.ai>"

# Server-only signing secret for auth magic/session tokens. Use a long random string.
AUTH_MAGIC_LINK_SECRET=replace-with-a-long-random-secret-value

# Facility source verification (NocoDB dashboard links; server-only — never in client bundle).
# NOCODB_DASHBOARD_BASE=https://noco-nocodb.tpwzwa.easypanel.host
# NOCODB_PROJECT_ID=py95wcp6hdidnbz
# NOCODB_DEFAULT_TABLE_ID=mcdzao3oejv4kud
# NOCODB_DEFAULT_VIEW_ID=vwxmsqy5cs1deezc
# SOURCE_LINK_SECRET=   # optional; falls back to AUTH_MAGIC_LINK_SECRET

# Server ops (Keystash codermaintenance + Discord approval workflow). Cloud agent secrets only — do not commit.
# Never paste private keys in Discord, email, or Google Sheets.
# SSH_CODER_PRIVATE_KEY=   # set in Cursor cloud agent secrets only (matches Keystash public key 6-3-26-coder-bot)
# GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON key for webhook-service-account@n8n-416-23.iam.gserviceaccount.com (Cursor secrets only)
# Mac/local one-liner: export GOOGLE_SERVICE_ACCOUNT_JSON="$(tr -d '\n' < ~/.credentials/google-service-account.json)"
# GOOGLE_SHEET_TAB=Server health   # optional worksheet name
# DISCORD_SERVER_OPS_WEBHOOK_URL=   # Incoming webhook for server maintenance requests

# Local dev only: Cloudflare tunnel token for https://agent1.assistedly.ai (see scripts/cloudflare-dev-tunnel.example.yml).
# ASSISTEDLY_TUNNEL_TOKEN=

# Local Mac only: cache purge via npm run ci:cf:purge (also set in GitHub Actions secrets for CI).
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
