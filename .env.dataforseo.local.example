# Copy this file to .env.dataforseo.local (gitignored) and fill in values.
# Then from the repo root: npm run mcp:dataforseo:sync
# Restart MCP in Cursor afterward.
#
# No spaces around "=". Use your DataForSEO API login (email) and API password.

DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Aliases also work:
# DATAFORSEO_LOGIN=...
# DATAFORSEO_API_PASSWORD=...
