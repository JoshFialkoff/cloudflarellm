{
  "name": "ai-assist-living-finder",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/postinstall/patch-react-dom-server-edge.mjs",
    "dev": "node scripts/next-dev-free-port.js",
    "dev:simple": "next dev --webpack -H 0.0.0.0 -p 3010",
    "tunnel:dev": "node scripts/cloudflare-dev-tunnel.cjs",
    "tunnel:dev:agent2": "DEV_PUBLIC_URL=https://agent2.assistedly.ai node scripts/cloudflare-dev-tunnel.cjs",
    "tunnel:dev:agent3": "DEV_PUBLIC_URL=https://agent3.assistedly.ai node scripts/cloudflare-dev-tunnel.cjs",
    "tunnel:dev:agent4": "DEV_PUBLIC_URL=https://agent4.assistedly.ai node scripts/cloudflare-dev-tunnel.cjs",
    "tunnel:kill-bridges": "node scripts/kill-tunnel-bridges.cjs",
    "tunnel:agent1-bridge": "node scripts/agent1-port-bridge.cjs",
    "prebuild": "npm run guard:full",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild",
    "build:turbo": "next build && node scripts/print-test-url.js",
    "start": "node scripts/ensure-next-build.js && next start",
    "guard:banner": "node scripts/guard-banner-css.cjs",
    "guard:homepage-copy": "node scripts/guard-homepage-copy.cjs",
    "guard:env-contract": "node scripts/guard-env-contract.cjs",
    "guard:compose": "node scripts/guard-compose-traefik.cjs",
    "guard:compose:dify": "node scripts/guard-compose-dify-host.cjs",
    "guard:wizard-budget-prefill": "node scripts/guard-wizard-budget-prefill.cjs",
    "guard:magic-link-titlecase": "node scripts/guard-titlecase-facility-type.cjs",
    "sync:charts": "INFISICAL_DOMAIN=https://secrets.assistedly.ai infisical run --env=dev -- node scripts/sync-noco-to-charts.cjs",
    "sync:charts:noinfisical": "node scripts/sync-noco-to-charts.cjs",
    "sync:charts:fallback": "ALLOW_CSV_FALLBACK=1 node scripts/sync-noco-to-charts.cjs",
    "sync:charts:deploy": "INFISICAL_DOMAIN=https://secrets.assistedly.ai infisical run --env=dev -- npm run sync:charts:noinfisical && npm run build && npx wrangler deploy --config wrangler-slot4.toml",
    "sync:charts:deploy:noinfisical": "npm run sync:charts:noinfisical && npm run build && npx wrangler deploy --config wrangler-slot4.toml",
    "smoke:homepage": "node scripts/smoke-homepage.cjs",
    "smoke:production": "node scripts/smoke-production-url.cjs",
    "intent-data:smoke": "node scripts/intent-data-smoke.cjs",
    "guard:empty-libs": "node scripts/guard-empty-libs.cjs",
    "guard:critical-features": "node scripts/guard-critical-features.mjs",
    "guard:favicon": "node scripts/guard-favicon.mjs",
    "guard:landing-banner-home-icon": "node scripts/guard-landing-banner-home-icon.mjs",
    "guard:responsive": "node scripts/guard-responsive.mjs",
    "guard:no-second-header": "node scripts/guard-no-second-header.mjs",
    "guard:data-quality": "node scripts/guard-data-quality.mjs",
    "guard:minimal-templates": "node scripts/guard-minimal-templates.mjs",
    "guard:system": "node scripts/guard-system.mjs",
    "guard:all": "npm run guard:critical-features && npm run guard:no-second-header && npm run guard:favicon && npm run guard:landing-banner-home-icon && npm run guard:responsive && npm run guard:data-quality && npm run guard:minimal-templates && npm run guard:event-taxonomy",
    "guard:event-taxonomy": "node scripts/guard-event-taxonomy.mjs",
    "guard:full": "npm run guard:system && npm run guard:all",
    "verify:deploy": "PRODUCTION_URL=https://assistedly.ai node scripts/verify-deploy.mjs",
    "deploy:slot4": "cd /Users/joshdev/Assistedly.ai && mv .dev.vars .dev.vars.bak 2>/dev/null; npx wrangler deploy --config wrangler-slot4.toml; DEPLOY_EXIT=$?; mv .dev.vars.bak .dev.vars 2>/dev/null; if [ $DEPLOY_EXIT -eq 0 ]; then npm run verify:deploy; fi; exit $DEPLOY_EXIT",
    "lint": "npm run guard:banner && npm run guard:homepage-copy && npm run guard:compose && npm run guard:compose:dify && npm run guard:wizard-budget-prefill && npm run guard:empty-libs && eslint pages/ components/",
    "agent:posthog-errors": "node scripts/posthog-errors-goose-agent.mjs",
    "agent:reddit": "node scripts/reddit-campaign-agent.cjs",
    "agent:reddit:optimize": "node scripts/reddit-structure-optimizer-agent.cjs",
    "agent:reddit:optimize:ask": "node scripts/reddit-optimizer-approval-loop.cjs",
    "agent:reddit:realtime": "node scripts/reddit-realtime-optimizer.cjs",
    "agent:social": "node scripts/social-engagement-agents.cjs",
    "agent:social:discord": "node scripts/send-social-leads-to-discord.cjs",
    "agent:social:daily": "npm run agent:social && npm run agent:social:discord",
    "ads:reddit:sync-urls": "node scripts/reddit-sync-ad-urls.cjs",
    "ads:reddit:discover": "node scripts/reddit-sync-ad-urls.cjs --discover-ad-accounts",
    "ads:reddit:oauth": "node scripts/reddit-oauth-login.cjs",
    "social:engagement:firecrawl": "node scripts/firecrawl-social-engagement.cjs",
    "social:organic:firecrawl": "FIRECRAWL_ENGAGEMENT_MODE=organic node scripts/firecrawl-social-engagement.cjs",
    "social:organic:discord": "node scripts/send-organic-social-to-discord.cjs",
    "social:organic:firecrawl:discord": "FIRECRAWL_ENGAGEMENT_MODE=organic ORGANIC_DISCORD_AUTO_SEND=1 node scripts/firecrawl-social-engagement.cjs",
    "social:founder-community:firecrawl": "FIRECRAWL_ENGAGEMENT_MODE=founder node scripts/firecrawl-social-engagement.cjs",
    "social:founder-community:firecrawl:nodiscord": "FIRECRAWL_ENGAGEMENT_MODE=founder FOUNDER_DISCORD_AUTO_SEND=0 node scripts/firecrawl-social-engagement.cjs",
    "mcp:dataforseo:sync": "node scripts/sync-dataforseo-mcp.cjs",
    "ci:cf:purge": "node scripts/ci/purge-cloudflare.mjs",
    "ci:remote:purge": "npm run ci:cf:purge",
    "ci:status:production": "node scripts/ci/status-check-discord.mjs",
    "ci:daily-analytics": "node scripts/ci/daily-analytics-discord.mjs",
    "ci:wizard-funnel": "node scripts/ci/analyze-wizard-funnel.mjs",
    "ci:setup-posthog-dashboard": "node scripts/ci/setup-posthog-dashboard.mjs",
    "ci:analytics:full": "npm run ci:daily-analytics && npm run ci:wizard-funnel",
    "ci:analytics:weekly": "LOOKBACK_HOURS=168 node scripts/ci/analytics-insight-monitor.mjs",
    "ops:health": "bash scripts/ops/collect-server-health.sh --all",
    "ops:analyze": "node scripts/ops/analyze-server-health.cjs --latest",
    "ops:sheet": "node scripts/ops/sync-server-sheet.cjs --latest",
    "ops:report": "npm run ops:health && npm run ops:analyze && npm run ops:sheet",
    "ops:discord": "node scripts/ops/post-server-ops-discord.cjs --analysis reports/server-health/$(ls -1 reports/server-health 2>/dev/null | tail -1)/analysis.json",
    "dify:import": "node scripts/dify-import-dsl.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "node --test __tests__/*.test.mjs",
    "sync:reviews": "INFISICAL_DOMAIN=https://secrets.assistedly.ai infisical run --env=dev -- node scripts/sync-reviews-to-nocodb.cjs",
    "sync:reviews:dry": "INFISICAL_DOMAIN=https://secrets.assistedly.ai infisical run --env=dev -- REVIEW_DRY_RUN=1 REVIEW_BATCH_SIZE=3 node scripts/sync-reviews-to-nocodb.cjs",
    "sync:intelligence": "node scripts/sync-facility-intelligence.cjs",
    "test:intelligence": "node scripts/validate-intelligence-libs.cjs",
    "guard:proprietary-data": "node scripts/guard-proprietary-data.mjs",
    "test:guards": "node scripts/guard-critical-features.mjs && node scripts/guard-no-second-header.mjs && node scripts/guard-proprietary-data.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.2.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@mendable/firecrawl-js": "^4.30.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "graphql": "^16.13.1",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.4",
    "posthog-js": "^1.414.0",
    "posthog-node": "^5.48.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "^18.3.12",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "postcss": "^8.5.16",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  }
}
