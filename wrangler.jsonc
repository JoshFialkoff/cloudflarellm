{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-llm-router",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "SANDBOX"
      }
    ]
  },
  "exports": {
    "Sandbox": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "sandbox-1"
    }
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ROUTER_KV",
      "id": "dbedcc63db6040bca9112a8625531a39"
    }
  ],
  "vars": {
    "MAX_ITERATIONS": "25",
    "SANDBOX_ID_PREFIX": "llm-session",
    "ACCOUNT_ID": "ad9d77d8f16147c01ff26b56d41cb5a9"
  },
  "triggers": {
    "crons": [
      "6 4 * * *",
      "6 5 * * *"
    ]
  },
  "containers": [
    {
      "name": "sandbox-1",
      "image": "docker.io/cloudflare/sandbox:next"
    }
  ]
}