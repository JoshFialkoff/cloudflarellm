{
  "name": "assistedly-secure-mcp",
  "version": "1.0.0",
  "description": "Production-secure Model Context Protocol server for Assistedly care-intelligence platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:stdio": "tsx src/server.ts --transport stdio",
    "dev:http": "tsx src/server.ts --transport http --port 8082",
    "test": "node --test dist/tests/*.js",
    "docker:build": "docker build -t assistedly-secure-mcp .",
    "docker:run": "docker run --rm -p 8082:8082 --read-only --security-opt no-new-privileges assistedly-secure-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.3.2",
    "jose": "^6.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["mcp", "assistedly", "care-intelligence", "security", "hipaa"],
  "author": "Assistedly.ai",
  "license": "UNLICENSED"
}
